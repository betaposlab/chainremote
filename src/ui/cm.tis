// ChainRemote(Agent32): Windows 프레임리스는 ui.rs 가 창 생성 시 처리한다(--cm = SW_MAIN, 타이틀바 없음).
//   여기 windowFrame 은 macOS(HQ) 확장 프레임 전용이다.
view.windowFrame = is_osx ? #extended : #solid;

var body;
var connections = [];
var show_chat = false;
var show_elevation = true;
var svg_elevate = <svg t="1667992597853" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="1850" width="16" height="16" xmlns:xlink="http://www.w3.org/1999/xlink"><path d="M892.761 160.724v426.504c0 25.588-6.419 51.036-19.177 76.339-12.798 25.336-29.547 49.86-50.254 73.627-20.707 23.79-44.372 46.296-70.97 67.516-26.589 21.244-53.543 40.177-80.921 56.768-27.363 16.623-53.968 30.461-79.801 41.438-25.809 11.008-48.433 18.547-67.871 22.64l-9.203 1.53-8.43-1.53c-19.958-4.093-43.094-11.632-69.432-22.64-26.337-10.969-53.708-24.816-82.080-41.438-28.388-16.591-56.256-35.524-83.618-56.768-27.378-21.219-51.776-43.725-73.265-67.516-21.488-23.759-38.868-48.291-52.155-73.627-13.319-25.305-19.974-50.759-19.974-76.339v-426.504l31.455-4.629 352.892-65.97 359.784 65.97 23.017 4.629zM510.028 151.884l-4.211-0.844-302.89 51.476v269.101h307.102v-319.734zM815.434 471.634h-305.406v383.031c19.682-4.51 41.052-11.411 64.141-20.692 23.033-9.249 45.815-20.234 68.304-32.867 22.513-12.672 44.159-26.739 64.969-42.203 20.818-15.472 39.23-32.047 55.277-49.797 16.024-17.703 28.822-36.131 38.386-55.222 9.549-19.131 14.328-38.553 14.328-58.235v-124.015z" p-id="1851" fill="#ffffff"></path></svg>;

var hide_cm = undefined;
function setWindowState(state) {
    if (hide_cm == undefined) hide_cm = handler.hide_cm();
    if (hide_cm) return;
    view.windowState = state;
}

class Body: Reactor.Component
{
    this var cur = 0;

    function this() {
        body = this;
    }

    function render() {
        if (connections.length == 0)
          return <div style="size:*; margin: * 0; text-align: center;">
                Waiting for new connection ...
                </div>;
        var c = connections[this.cur];
        this.connection = c;
        this.cid = c.id;
        var auth = c.authorized;
        var me = this;
        var callback = function(msg) {
            me.sendMsg(msg);
        };
        var right_style = show_chat ? "" : "display: none";
        var disconnected = c.disconnected;
        var show_elevation_btn = handler.can_elevate() && show_elevation && !c.is_file_transfer && !c.is_view_camera && !c.is_terminal && c.port_forward.length == 0;
        // ChainRemote(Agent32): 권한 아이콘 그리드는 렌더하지 않는다. 클릭수락 정책이라 거래처 화면을
        // 단순하게 두고 Flutter 수락카드와 톤을 맞춘다. 권한 기본값은 toml/서버 정책이 정한다. Sciter cm 은 Agent32 전용.
        var show_accept_btn = handler.get_option('approve-mode') != 'password';
        // ChainRemote(Agent32): 활성 세션이면 슬림 "원격지원 중" 배너를 띄운다(Flutter 톤).
        //   빨간 점 + "원격지원 중" + [원격 종료]. 전체 카드 대신 이걸 보여줘 거래처가 원격 중임을 항상 알게 한다.
        if (auth && !disconnected) {
            // ChainRemote: role=window-caption 이면 배너를 잡고 끌어 옮길 수 있다.
            //   #disconnect 버튼은 interactive라 드래그에서 빠진다(클릭 유지). no-focus(스캐너 보호)는
            //   windowTopmost만 쓰고 view.focus 는 안 부르는 방식(applyCmBanner)이라 드래그와 충돌하지 않는다.
            // ChainRemote: 배너에 채팅을 붙인다. 종전엔 본사가 보낸 메시지가 여기 도착해도
            //   그릴 자리가 없어 조용히 사라졌다(수락카드/배너로 갈아엎을 때 같이 잘려 나갔다).
            //   말풍선을 누르면 접었다 폈다 하고, 안 읽은 게 있으면 점이 붙는다.
            var unread = c.unreaded > 0 && !show_chat;
            return <div .banner-wrap>
                <div .support-banner role="window-caption">
                    <span .banner-dot />
                    <span .banner-label>{translate('Remote support in progress')}</span>
                    <button #bannerchat .banner-chatbtn>
                        {svg_chat}
                        {unread ? <span .banner-unread /> : ""}
                    </button>
                    <button #disconnect .banner-end>{translate('Disconnect')}</button>
                </div>
                {show_chat ?
                    <div .banner-chatpane>
                        <ChatBox msgs={c.msgs} callback={callback} />
                    </div> : ""}
            </div>;
        }
        // ChainRemote(Agent32): 대기(미수락) 상태는 Flutter "원격지원 요청" 카드와 톤을 맞춘다.
        //   제목 + 안내문 + 본사 ID + [거부]/[수락]. 모지바케를 피하려 translate() 를 쓴다.
        if (!auth && !disconnected) {
            // 상호가 앞에 온다("대전문성텔레콤에서 이 PC 에 …"). 9자리 ID 는 사장님에게
            //   아무 의미가 없어서 뺐다. 상호는 heartbeat 가 받아 캐시해 둔 값이고,
            //   아직 못 받았으면(구버전 서버·첫 하트비트 전) "본사"로 대체한다.
            var who = "";
            try { who = handler.get_support_name(); } catch (e) { }
            if (!who) who = translate('Headquarters');
            return <div .accept-card>
                <div .ac-rail>
                    <div .ac-icon>
                        <div .ac-mon />
                        <div .ac-monbase />
                    </div>
                </div>
                <div .ac-inner>
                    <div .ac-title>{translate('Remote support request')}</div>
                    <div .ac-body><b>{who}</b>{translate('requested remote access to this PC suffix')}</div>
                    <div .ac-buttons>
                        <button #dismiss .ac-deny>{translate('Dismiss')}</button>
                        <button #accept .ac-accept>{translate('Accept')}</button>
                    </div>
                </div>
            </div>;
        }
       // below size:* is a workaround for Linux, it already set in css, but not work, shit sciter
        return <div .content style="size:*">
            <div .left-panel>
                <div .icon-and-id>
                    {c.avatar ?
                    <img .icon src={c.avatar} /> :
                    <div .icon style={"background: " + string2RGB(c.name, 1)}>
                    {c.name[0].toUpperCase()}
                    </div>}
                    <div>
                        <div .id style="font-weight: bold; font-size: 1.2em;">{c.name}</div>
                        <div .id>({c.peer_id})</div>
                        <div style="margin-top: 1.2em">{auth
                            ? <span>{disconnected ? translate('Disconnected') : translate('Connected')}{" "}<span #time>{getElapsed(c.time, c.now)}</span></span> 
                            : <span>{translate('Request access to your device')}{"..."}</span>}
                        </div>
                    </div>
                </div>
                <div />
                {c.is_file_transfer ? <div>{translate('Transfer file')}</div> : ""}
                {c.is_view_camera ? <div>{translate('View camera')}</div> : ""}
                {c.is_terminal ? <div>{translate('Terminal')}</div> : ""}
                {c.port_forward ? <div>Port Forwarding: {c.port_forward}</div> : ""}
                <div style="size:*"/>
                <div .outer_buttons>
                    {!auth && !disconnected && show_elevation_btn && show_accept_btn ? <button #elevate_accept .control .elevate .button><span><span><span>{svg_elevate}</span><span>{translate('Accept')}</span></span></span></button> : "" }
                    {auth && !disconnected && show_elevation_btn ? <button #elevate .control .elevate .button><span><span><span>{svg_elevate}</span><span>{translate('Elevate')}</span></span></span></button> : "" }
                    <div .inner_buttons style={auth ? "display:none;":""}>
                        {!auth && show_accept_btn ? <button #accept .control .button>{translate('Accept')}</button> : "" }
                        {!auth ? <button #dismiss .control .outline>{translate('Dismiss')}</button> : "" }
                    </div>
                    {auth && !disconnected ? <button #disconnect .control .button>{translate('Disconnect')}</button> : "" }
                    {auth && disconnected ? <button #close .control .button>{translate('Close')}</button> : "" }
                </div>
                {c.is_file_transfer || c.is_terminal || c.port_forward ? "" : <div .chaticon>{svg_chat}</div>}
            </div>
            <div .right-panel style={right_style}>
                {c.is_file_transfer || c.is_terminal || c.port_forward ? "" : <ChatBox msgs={c.msgs} callback={callback} />}
            </div>
        </div>;
    }

    function sendMsg(text) {
        if (!text) return;
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.msgs.push({ name: "me", text: text, time: getNowStr()});
            handler.send_msg(cid, text);
            body.update();
        });
    }

    event click $(icon.keyboard) (e) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.keyboard = !connection.keyboard;
            body.update();
            handler.switch_permission(cid, "keyboard", connection.keyboard);
        });
    }

    event click $(icon.clipboard) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.clipboard = !connection.clipboard;
            body.update();
            handler.switch_permission(cid, "clipboard", connection.clipboard);
        });
    }

    event click $(icon.audio) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.audio = !connection.audio;
            body.update();
            handler.switch_permission(cid, "audio", connection.audio);
        });
    }

    event click $(icon.file) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.file = !connection.file;
            body.update();
            handler.switch_permission(cid, "file", connection.file);
        });
    }

    event click $(icon.restart) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.restart = !connection.restart;
            body.update();
            handler.switch_permission(cid, "restart", connection.restart);
        });
    }

    event click $(icon.recording) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.recording = !connection.recording;
            body.update();
            handler.switch_permission(cid, "recording", connection.recording);
        });
    }

    event click $(icon.block_input) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.block_input = !connection.block_input;
            body.update();
            handler.switch_permission(cid, "block_input", connection.block_input);
        });
    }

    event click $(button#accept) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.authorized = true;
            body.update();
            handler.authorize(cid);
            self.timer(30ms, applyCmBanner);
        });
    }

    event click $(button#elevate_accept) {
        var { cid, connection } = this;
        checkClickTime(function() {
            connection.authorized = true;
            show_elevation = false;
            body.update();
            handler.elevate_portable(cid);
            handler.authorize(cid);
            self.timer(30ms, applyCmBanner);
        });
    }

    event click $(button#elevate) {
        var { cid, connection } = this;
        checkClickTime(function() {
            show_elevation = false;
            body.update();
            handler.elevate_portable(cid);
            self.timer(30ms, applyCmBanner);
        });
    }

    event click $(button#dismiss) {
        var cid = this.cid;
        checkClickTime(function() {
            handler.close(cid);
        });
    }

    // ChainRemote: 배너의 말풍선 — 채팅 접기/펼치기.
    //   ★checkClickTime 가드를 쓰지 않는다. 그 가드는 본사가 원격으로 눌러 셀프 수락하는 걸
    //     막으려는 것이고(#accept/#dismiss), 채팅 펼치기는 본사가 대신 눌러 줘도 무해하다.
    //   ★view.focus 를 주지 않는다. 포스에서 포커스를 뺏으면 바코드 스캐너가 먹통이 된다 —
    //     사장님이 입력칸을 직접 눌렀을 때만 포커스가 가야 한다(원본 chaticon 핸들러와 다른 점).
    event click $(button#bannerchat) {
        show_chat = !show_chat;
        if (show_chat) {
            var c = connections[body.cur];
            if (c) c.unreaded = 0;
            scheduleChatCollapse();   // 직접 펼친 것도 조용해지면 접힌다
        } else {
            chat_idle_timer_gen++;    // 직접 접었으면 대기 중인 타이머 무효화
        }
        applyCmBanner();
        body.update();
    }

    event click $(button#disconnect) {
        // ChainRemote: 원격 종료는 원격 클릭도 허용한다. Flutter 에이전트(_buildEndButton, 가드 없음)와
        //   동작을 맞춘다. controller 가 세션을 끊는 건 자기 창 닫기와 같아 무해하다.
        //   반면 수락/거부(#accept/#dismiss)의 checkClickTime 가드는 셀프 수락 방지를 위해 유지한다.
        handler.close(this.cid);
    }

    event click $(button#close) {
        var cid = this.cid;
        if (this.cur >= 0 && this.cur < connections.length){
            handler.remove_disconnected_connection(cid);
            connections.splice(this.cur, 1);
            if (connections.length > 0) {
                if (this.cur > 0)
                    this.cur -= 1; 
                else
                    this.cur = connections.length - 1;
                header.update();
                body.update();
            } else {
                handler.quit();
            }
        }
        
    }
}

$(body).content(<Body />);

var header;

class Header: Reactor.Component
{
    function this() {
        header = this;
    }

    function render() {
        var me = this;
        var conn = connections[body.cur];
        if (conn && conn.unreaded > 0) {;
            var el = me.select("#unreaded" + conn.id);
            if (el) el.style.set {
                display: "inline-block",
            };
            self.timer(300ms, function() {
                conn.unreaded = 0;
                var el = me.select("#unreaded" + conn.id);
                if (el) el.style.set {
                    display: "none",
                };
            });
        }
        var tabs = connections.map(function(c, i) { return me.renderTab(c, i) });
        return <div .tabs-wrapper><div .tabs>
            {tabs}
            </div>
            <div .tab-arrows>
                <span #left-arrow>&lt;</span>
                <span #right-arrow>&gt;</span>
            </div>
        </div>;
    }

    function renderTab(c, i) {
        var cur = body.cur;
        return <div class={i == cur ? "active-tab tab" : "tab"}>
            {c.name}
            {c.unreaded > 0 ? <span .unreaded id={"unreaded" + c.id}>{c.unreaded}</span> : ""}
        </div>;
    }

    function update_cur(idx) {
        checkClickTime(function() {
            body.cur = idx;
            update();
            self.timer(1ms, adjustHeader);
        });
    }

    event click $(div.tab) (_, me) {
        var idx = me.index;
        if (idx == body.cur) return;
        this.update_cur(idx);
    }

    event click $(span#left-arrow) {
        var cur = body.cur;
        if (cur == 0) return;
        this.update_cur(cur - 1);
    }

    event click $(span#right-arrow) {
        var cur = body.cur;
        if (cur == connections.length - 1) return;
        this.update_cur(cur + 1);
    }
}

if (is_osx) {
    $(header).content(<Header />);
    $(header).attributes["role"] = "window-caption";
} else {
    $(div.window-toolbar).content(<Header />);
    setWindowButontsAndIcon(true);
}

event click $(div.chaticon) {
    checkClickTime(function() {
        show_chat = !show_chat;
        adaptSizeForChat();
        if (show_chat) {
            view.focus = $(.outline-focus);
        }
    });
}

function checkClickTime(callback) {
    var click_callback_time = getTime();
    handler.check_click_time(body.cid);
    self.timer(120ms, function() {
        var d = click_callback_time - handler.get_click_time();
        if (d > 120)
            callback();
    });
}

function adaptSizeForChat() {
    $(div.right-panel).style.set {
        display: show_chat ? "block" : "none",
    };
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    if (show_chat && w < scaleIt(600)) {
        view.move(x - (scaleIt(600) - w), y, scaleIt(600), h);
    } else if (!show_chat && w > scaleIt(450)) {
        // ChainRemote(Agent32): 채팅을 닫으면 기본 카드 폭(380)으로 되돌린다 (원본은 300).
        view.move(x + (w - scaleIt(380)), y, scaleIt(380), h);
    }
}

var cm_banner_state = undefined;
// 배너에서 채팅을 펼친 상태. applyCmBanner 가 창 크기를 다시 잡을지 판단하는 데 같이 쓴다.
var cm_banner_chat_state = undefined;

// ChainRemote: 조용해지면 채팅을 스스로 접는다.
//
// 왜 필요한가: 사장님은 채팅을 닫을 생각을 안 한다. 본사가 자기 쪽 채팅창을 닫아도
// 거래처 화면엔 그대로 남아 포스 화면을 계속 가린다(2026-08-14 테스트1 실측).
// 본사가 닫을 때 같이 닫으려면 "채팅창 닫음" 프로토콜 메시지가 필요한데 RustDesk 엔 없고,
// 코어 통신 경로를 건드릴 만한 값어치도 없다 — 게다가 사장님이 아직 읽는 중일 수도 있다.
// 대신 로컬 타이머로 접는다. 본사가 뭘 하든, 연결이 끊겨도 항상 동작한다.
// 안 읽은 표시(빨간 점)는 남으니 다시 펼쳐 읽을 수 있고, 대화는 지워지지 않는다.
const CHAT_IDLE_COLLAPSE_MS = 60000;
var chat_idle_timer_gen = 0;

// 조용해지면 접기 — 타이머를 다시 걸 때마다 세대를 올려 이전 타이머를 무효화한다.
//   (메시지가 연달아 오면 타이머가 여러 개 살아 마지막 것만 유효해야 한다.)
function scheduleChatCollapse() {
    var myGen = ++chat_idle_timer_gen;
    self.timer(CHAT_IDLE_COLLAPSE_MS, function() {
        if (myGen != chat_idle_timer_gen) return;   // 더 최근 메시지가 타이머를 새로 걸었다
        if (!show_chat) return;
        // 사장님이 답장을 쓰는 중이면 접지 않는다 — 쓰던 글이 사라지면 최악이다.
        var el = $(div.banner-chatpane input);
        if (el && (el.value || "").trim()) { scheduleChatCollapse(); return; }
        show_chat = false;
        applyCmBanner();
        body.update();
    });
}

// 세션이 끝나면 채팅 상태를 원위치. ★안 하면 show_chat 이 전역이라 **다음 세션이 채팅을
//   펼친 채로 시작한다** — 아무도 열지 않았는데 열려 있는 창이 된다.
function resetChatState() {
    chat_idle_timer_gen++;   // 진행 중인 접기 타이머 무효화
    show_chat = false;
}
// ChainRemote(Agent32): 활성 세션이면 cm 창을 슬림 "원격지원 중" 배너로(상단 중앙, 상시 최상위),
//   대기/끊김이면 카드 크기로 되돌린다. 떨림을 막으려 전환 시에만 view.move 한다.
//   windowTopmost=true 만 설정하고 view.focus 는 건드리지 않는다. z-order 만 최상위로 올라가고
//   키보드 포커스는 뺏지 않아 POS 바코드 스캐너 입력을 보호한다 (2026-06-12 보류 건의 정공법).
function applyCmBanner() {
    if (connections.length == 0) return;
    // 프레임리스(Flutter 톤): HTML 타이틀바 <header> 는 항상 숨긴다. 수락카드·배너 모두 프레임이 없다.
    var hdr = $(header);
    if (hdr) hdr.style.set { display: "none" };
    var active = false;
    var pending = false;
    for (var i = 0; i < connections.length; i++) {
        if (connections[i].authorized && !connections[i].disconnected) active = true;
        if (!connections[i].authorized && !connections[i].disconnected) pending = true;
    }
    // ★수락 대기가 하나라도 있으면 카드 크기가 우선이다 (2026-07-31 테스트1 실측).
    //   종전엔 active 만 봤다 → 이미 원격 중(배너 260x48)인데 두 번째 본사가 접속을 시도하면
    //   창은 배너 크기 그대로인 채 내용만 수락카드로 바뀌어, 카드가 넘쳐 스크롤바가 생기고
    //   [수락] 버튼이 화면 밖으로 밀렸다. 거래처가 스크롤을 내려야 수락할 수 있다는 건
    //   "수락만 누르면 끝" 이라는 우리 UX 약속을 깬다. Flutter(x64) cm 은 원래 대기 우선이라
    //   이 증상이 32비트(Win7) 에서만 났다 — 그 동작에 맞춘다.
    var wantBanner = active && !pending;
    // ChainRemote: 채팅 펼침도 상태의 일부다. 종전엔 wantBanner 만 비교해서, 배너인 채로
    //   채팅을 펼치면 "상태 안 바뀜"으로 조기 반환해 창이 260x48 그대로였다 — 채팅이
    //   그려져도 볼 수가 없다.
    var wantChat = wantBanner && show_chat;
    if (cm_banner_state == wantBanner && cm_banner_chat_state == wantChat) return;
    cm_banner_state = wantBanner;
    cm_banner_chat_state = wantChat;
    var (sw, sh) = view.screenBox(#workarea, #dimension);
    if (wantBanner) {
        // 활성: 슬림 "원격지원 중" 배너 (상단 중앙, 상시 최상위, focus 안 뺏음=스캐너 보호).
        //   채팅을 펼쳤으면 아래로 자란다. 폭은 카드와 맞춰 좌우로 미끄러지지 않게 한다.
        var w = wantChat ? scaleIt(380) : scaleIt(260);
        var h = wantChat ? scaleIt(300) : scaleIt(48);
        setWindowState(View.WINDOW_SHOWN);
        view.move((sw - w) / 2, 0, w, h);
        view.windowTopmost = true;
        // 창 자체를 활성화 불가(NOACTIVATE)+Alt+Tab 제외(TOOLWINDOW)로. POS 의 "바탕화면 보기"가
        //   topmost 배너에 포커스를 뺏겨 방금 최소화한 POS 를 도로 띄우던 문제를 끊는다
        //   (태조산 현장 2026-07-25). 클릭은 그대로라 [종료] 버튼은 동작한다.
        handler.set_banner_mode(true);
        // 카드(380x260)에서 배너(260x48)로 줄었으니 비운 자리를 다시 그리게 한다.
        //   Aero 꺼진 구형 Win7 POS 는 그 영역이 자동 무효화되지 않아 직전 프레임이
        //   검은 상자처럼 남는다 (2026-07-31 테스트1). Win10 은 원래 안 남지만 무해하다.
        var cw = scaleIt(380);
        var ch = scaleIt(260);
        handler.repaint_area((sw - cw) / 2, 0, cw, ch);
    } else {
        // 대기(수락카드)/끊김: 카드 크기. 카드는 거래처가 눌러야 하는 창이라 스타일을 원복한다.
        var w = scaleIt(380);
        var h = scaleIt(260);
        handler.set_banner_mode(false);
        view.windowTopmost = false;
        view.move((sw - w) / 2, 0, w, h);
    }
}

// ChainRemote(Agent32): [수락] 버튼 맥동 — Flutter _PulsingAcceptButton 과 신호 통일
//   (짙은 파랑 #1740C4 ↔ 밝은 파랑 #5A8CFF, 750ms 왕복, ease-in-out).
//   ★2026-08-06 카드 테두리(빨강)에서 버튼으로 옮겼다. 빨간 테두리는 오류창 문법이라
//   도와주러 온 요청에 "위험" 신호를 보냈고, 시선은 어차피 눌러야 할 버튼으로 가야 한다.
//   이 Sciter 버전엔 CSS keyframes/box-shadow 가 없어 타이머로 색을 직접 보간한다.
//   버튼이 DOM 에서 사라지면(수락/거부/끊김) 타이머가 스스로 멈추고, 다음 update() 가 살린다.
var cm_pulse_running = false;
var cm_pulse_ms = 0;
function applyAcceptPulse() {
    if (cm_pulse_running) return;
    if (!$(button.ac-accept)) return;
    cm_pulse_running = true;
    cm_pulse_ms = 0;
    self.timer(66ms, function() {
        var el = $(button.ac-accept);
        if (!el) { cm_pulse_running = false; return false; }
        cm_pulse_ms = (cm_pulse_ms + 66) % 1500;
        var t = cm_pulse_ms < 750 ? cm_pulse_ms / 750.0 : (1500 - cm_pulse_ms) / 750.0;
        t = t * t * (3.0 - 2.0 * t);  // smoothstep ≈ Flutter Curves.easeInOut
        var r = (0x17 + 67 * t).toInteger();   // 0x17→0x5A
        var g = (0x40 + 76 * t).toInteger();   // 0x40→0x8C
        var b = (0xC4 + 59 * t).toInteger();   // 0xC4→0xFF
        el.style.set { "background": String.printf("#%02X%02X%02X", r, g, b) };
        return true;  // 타이머 유지
    });
}

function update() {
    header.update();
    body.update();
    applyCmBanner();
    applyAcceptPulse();
}

function bring_to_top(idx=-1) {
    if (view.windowState == View.WINDOW_HIDDEN || view.windowState == View.WINDOW_MINIMIZED) {
        if (is_linux) {
            view.focus = self;
        } else {
            setWindowState(View.WINDOW_SHOWN);
        }
        if (idx >= 0) body.cur = idx;
    } else {
        view.windowTopmost = true;
        view.windowTopmost = false;
    }
}

handler.addConnection = function(id, is_file_transfer, is_view_camera, is_terminal, port_forward, peer_id, name, avatar, authorized, keyboard, clipboard, audio, file, restart, recording, block_input) {
    stdout.println("new connection #" + id + ": " + peer_id);
    var conn;
    connections.map(function(c) {
        if (c.id == id) conn = c;
    });
    if (conn) {
        conn.authorized = authorized;
        update();
        return;
    }
    var idx = -1;
    connections.map(function(c, i) {
        if (c.disconnected && c.peer_id == peer_id) idx = i;
    });
    if (!name) name = "NA";
    conn = {
        id: id, is_file_transfer: is_file_transfer, is_view_camera: is_view_camera, is_terminal: is_terminal, peer_id: peer_id,
        port_forward: port_forward,
        avatar: avatar,
        name: name, authorized: authorized, time: new Date(), now: new Date(),
        keyboard: keyboard, clipboard: clipboard, msgs: [], unreaded: 0,
        audio: audio, file: file, restart: restart, recording: recording,
        block_input:block_input,
        disconnected: false
    };
    if (idx < 0) {
        connections.push(conn);
        body.cur = connections.length - 1;
    } else {
        connections[idx] = conn;
        body.cur = idx;
    }
    bring_to_top();
    update();
    self.timer(1ms, adjustHeader);
    // ChainRemote: 수락 3초 후 cm 창을 최소화하던 원본 RustDesk 동작을 제거했다. 항상 보이는
    //   "원격지원 중" 배너와 충돌해 배너가 떴다가 3초 뒤 사라지던 원인이었다.
    //   창 상태는 applyCmBanner 가 관리한다(활성=슬림 배너 / 대기·끊김=카드).
}

handler.removeConnection = function(id, close) {
    var i = -1;
    connections.map(function(c, idx) {
        if (c.id == id) i = idx;
    });
    if (i < 0) return;
    if (close) {
        connections.splice(i, 1);
    } else {
        var conn = connections[i];
        conn.disconnected = true;
    }
    // ChainRemote: 활성 세션이 없어지면 채팅을 원위치. show_chat 이 전역이라 안 그러면
    //   다음 세션이 채팅을 펼친 채로 시작한다(아무도 열지 않았는데 열려 있는 창).
    var stillActive = false;
    for (var k = 0; k < connections.length; k++) {
        if (connections[k].authorized && !connections[k].disconnected) stillActive = true;
    }
    if (!stillActive) resetChatState();
    if (connections.length > 0) {
        if (body.cur >= i && body.cur > 0 && close) body.cur -= 1;
        update();
    }
}

handler.newMessage = function(id, text) { 
    var idx = -1;
    connections.map(function(c, i) {
        if (c.id == id) idx = i;
    });
    var conn = connections[idx];
    if (!conn) return;
    conn.msgs.push({name: conn.name, text: text, time: getNowStr()});
    // ChainRemote: 배너 모드(원격 중)면 원본 경로를 타지 않는다. 두 가지가 해롭다 —
    //   ① bring_to_top 은 windowTopmost 를 켰다 바로 끄므로 배너의 상시 최상위가 풀린다.
    //      숨김/최소화 상태였다면 setWindowState(SHOWN) 까지 불러 포스 화면을 건드린다.
    //   ② adaptSizeForChat 은 우측 패널을 펴며 창을 600px 로 넓히는데, 그건 탭 레이아웃
    //      전제다. 배너에선 applyCmBanner 가 크기의 단일 창구라 둘이 싸운다.
    //   대신 배너 안에서 펼치고, 창 크기는 applyCmBanner 한 곳에서만 잡는다.
    if (cm_banner_state) {
        conn.unreaded += 1;
        if (idx == body.cur) {
            show_chat = true;
            applyCmBanner();
            scheduleChatCollapse();   // 조용해지면 스스로 접힌다
        }
        update();
        return;
    }
    bring_to_top(idx);
    if (idx == body.cur) {
        var shouldAdapt = !show_chat;
        show_chat = true;
        if (shouldAdapt) adaptSizeForChat();
    }
    conn.unreaded += 1;
    update();
}

handler.showElevation = function(show) {
    if (show != show_elevation) {
        show_elevation = show;
        update();
    }
}

view << event statechange {
    adjustBorder();
}

function self.ready() {
    adjustBorder();
    var (sw, sh) = view.screenBox(#workarea, #dimension);
    // ChainRemote(Agent32): Flutter 수락카드(상단 중앙)와 톤을 맞춘 카드형 작은 창.
    // "작게 띄우고 키우기 금지" 원칙(docs/chainremote/CM_WINDOW.md §2)은 Flutter 경로 얘기지만,
    // 여기서도 처음부터 최종 크기로 띄운다.
    var w = scaleIt(380);
    var h = scaleIt(260);
    view.move((sw - w) / 2, 0, w, h);
}

function getElapsed(time, now) {
    var seconds = Date.diff(time, now, #seconds);
    var hours = seconds / 3600;
    var days = hours / 24;
    hours = hours % 24;
    var minutes = seconds % 3600 / 60;
    seconds = seconds % 60;
    var out = String.printf("%02d:%02d:%02d", hours, minutes, seconds);
    if (days > 0) {
        out = String.printf("%d day%s %s", days, days > 1 ? "s" : "", out);
    }
    return out;
}

var ui_status_cache = [""];
function check_update_ui() {
    self.timer(1s, function() {
        var approve_mode = handler.get_option('approve-mode');
        var changed = false;
        if (ui_status_cache[0] != approve_mode) {
            ui_status_cache[0] = approve_mode;
            changed = true;
        }
        if (changed) update();
        check_update_ui();
    });                          
}
check_update_ui();

function updateTime() {
    self.timer(1s, function() {
        var now = new Date();
        connections.map(function(c) {
            if (!c.authorized) c.time = now;
            if (!c.disconnected) c.now = now;
        });
        var el = $(#time);
        if (el) {
            var c = connections[body.cur];
            if (c && c.authorized && !c.disconnected) {
                el.text = getElapsed(c.time, c.now);
            }
        }
        updateTime();
    });
}

updateTime();

var tm0 = getTime();

function self.closing() {
    if (connections.length == 0 && getTime() - tm0 > 30000) return true;
    setWindowState(View.WINDOW_HIDDEN);
    return false;
}


function adjustHeader() {
    var hw = $(header).box(#width) / scaleFactor;
    var tabswrapper = $(div.tabs-wrapper);
    var tabs = $(div.tabs);
    var arrows = $(div.tab-arrows);
    if (!arrows) return;
    var n = connections.length;
    var wtab = 80;
    var max = hw - 98;
    var need_width = n * wtab + scaleIt(2); // include border of active tab
    if (need_width < max) {
        arrows.style.set {
            display: "none",
        };
        tabs.style.set {
            width: need_width,
            margin-left: 0,
        };
        tabswrapper.style.set {
            width: need_width,
        };
    } else {
        var margin = (body.cur + 1) * wtab - max + 30;
        if (margin < 0) margin = 0;
        arrows.style.set {
            display: "block",
        };
        tabs.style.set {
            width: (max - 20 + margin) + 'px',
            margin-left: -margin + 'px'
        };
        tabswrapper.style.set {
            width: (max + 10) + 'px',
        };
    }
}

view.on("size", adjustHeader);

