# ChainRemote 클라우드 앞단.
#
# Caddy 를 쓰는 이유: 인증서 발급과 갱신을 스스로 한다. 갱신을 놓치면 에이전트
# 하트비트가 통째로 끊기는데 그건 아무 소리 없이 일어난다. 사람이 기억해야
# 하는 절차를 하나라도 줄이는 쪽을 골랐다.
#
# 로그는 journald 로 보낸다(기본값). systemd 유닛이 /var/log 쓰기를 막고 있고,
# 파일로 빼봤자 회전 관리가 하나 더 늘 뿐이다. 조회는 journalctl -u caddy.
#
# 패널 자체는 127.0.0.1:3001 에만 바인딩돼 있다. 밖으로 나가는 길은 여기뿐이다.
#
#   626.kr      사람이 보는 관리 패널 + /main 영업 랜딩
#   api.626.kr  에이전트가 두드리는 API. 같은 앱이지만 이름을 나눠둬야
#               나중에 패널과 API 를 다른 서버로 쪼갤 때 DNS 만 바꾸면 된다.

626.kr, api.626.kr {
	encode zstd gzip

	# /main = 영업 랜딩. 클라우드가 직접 낸다(2026-08-05 — 종전 302 리다이렉트 대체).
	#   ★HTML·로고만 여기 있다. 35MB 설치파일은 Cafe24 에 두고 절대주소로 링크한다 —
	#   방문자 다운로드를 클라우드 트래픽(하루 33GB 한도)으로 받을 이유가 없다.
	#   파일 갱신은 deploy/nas/publish-landing.sh [7/7] 이 자동으로 한다.
	# /main → /main/ 정규화. 슬래시가 없으면 브라우저가 상대경로(logo.png)를 사이트
	#   루트 기준으로 풀어 패널 쪽으로 새 나간다 — Cafe24(Apache)는 이 리다이렉트를
	#   자동으로 해줘서 그쪽만 멀쩡했고 여기만 로고가 깨졌다(2026-08-06).
	redir /main /main/ 301

	handle_path /main* {
		root * /opt/chainremote/web/main
		file_server
	}

	# 나머지는 전부 패널/API. 에이전트가 보내는 X-ChainRemote-Token 등 헤더는 그대로 통과.
	handle {
		reverse_proxy 127.0.0.1:3001 {
			header_up X-Real-IP {remote_host}
		}
	}
}
